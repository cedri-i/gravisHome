---
const href = 'https://gravi-lamplight-reading.pijathamil1.chatgpt.site/';
---

<a class="home-entry-card home-entry-card-notes reading-notes-card" href={href}>
  <svg class="reading-notes-mark" viewBox="0 0 64 64" fill="none" aria-hidden="true">
    <path class="reading-notes-paper" d="M10 14C18 11 25 13 32 18C39 13 46 11 54 14V47C46 44 39 46 32 51C25 46 18 44 10 47Z" />
    <path d="M10 14C18 11 25 13 32 18V51C25 46 18 44 10 47V14ZM32 18C39 13 46 11 54 14V47C46 44 39 46 32 51M17 25C20 25 23 26 26 28M17 33C20 33 23 34 26 36M38 34C41 32 44 31 47 31M38 41C41 39 44 38 47 38" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <path class="reading-notes-bookmark" d="M42 10L49 9V29L45.5 26L42 30V10Z" />
  </svg>
  <div class="home-entry-content">
    <div class="home-entry-title">读书札记 →</div>
    <div class="home-entry-desc">阅读我的读书札记</div>
  </div>
</a>

<style>
  .reading-notes-mark {
    flex: 0 0 2.7rem;
    width: 2.7rem;
    height: 2.7rem;
    color: var(--sl-color-text);
  }
  .reading-notes-paper {
    fill: color-mix(in srgb, var(--entry-border) 16%, transparent);
  }
  .reading-notes-bookmark { fill: var(--entry-border); }
  .reading-notes-card:focus-visible {
    outline: 2px solid var(--entry-border);
    outline-offset: 4px;
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-notes-card,
    .reading-notes-card::after { transition: none; }
    .reading-notes-card:hover { transform: none; }
  }
</style>
