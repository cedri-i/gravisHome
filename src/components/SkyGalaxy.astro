<div id="sky-galaxy" aria-hidden="true">
  <svg viewBox="0 0 1100 680" focusable="false">
    <defs>
      <radialGradient id="galaxy-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#ffe8bd" stop-opacity=".2" />
        <stop offset=".16" stop-color="#cdb8eb" stop-opacity=".17" />
        <stop offset=".38" stop-color="#8784c5" stop-opacity=".13" />
        <stop offset=".68" stop-color="#5d9bb7" stop-opacity=".08" />
        <stop offset="1" stop-color="#345779" stop-opacity="0" />
      </radialGradient>

      <radialGradient id="galaxy-core" cx="46%" cy="45%" r="56%">
        <stop offset="0" stop-color="#fff9e6" stop-opacity=".86" />
        <stop offset=".13" stop-color="#f4d6ae" stop-opacity=".76" />
        <stop offset=".34" stop-color="#c8a0c8" stop-opacity=".42" />
        <stop offset=".58" stop-color="#8d87c7" stop-opacity=".24" />
        <stop offset=".82" stop-color="#6aa2ba" stop-opacity=".08" />
        <stop offset="1" stop-color="#496c91" stop-opacity="0" />
      </radialGradient>

      <linearGradient id="galaxy-arm" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f3d8b3" />
        <stop offset=".24" stop-color="#c6b0d5" />
        <stop offset=".58" stop-color="#8ea4c9" />
        <stop offset=".82" stop-color="#6b96af" />
        <stop offset="1" stop-color="#43617d" />
      </linearGradient>

      <linearGradient id="galaxy-dust" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#161527" stop-opacity=".12" />
        <stop offset=".38" stop-color="#050b16" stop-opacity=".92" />
        <stop offset=".72" stop-color="#0a1322" stop-opacity=".76" />
        <stop offset="1" stop-color="#172638" stop-opacity="0" />
      </linearGradient>

      <filter id="galaxy-blur-xl" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="34" />
      </filter>
      <filter id="galaxy-blur-md" x="-35%" y="-35%" width="170%" height="170%">
        <feGaussianBlur stdDeviation="12" />
      </filter>
      <filter id="galaxy-blur-sm" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="4.2" />
      </filter>

      <radialGradient id="galaxy-fade" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="white" />
        <stop offset=".62" stop-color="white" stop-opacity=".88" />
        <stop offset="1" stop-color="black" />
      </radialGradient>
      <mask id="galaxy-arm-mask">
        <circle cx="0" cy="0" r="430" fill="url(#galaxy-fade)" />
      </mask>

      <path
        id="galaxy-spiral-arm"
        d="M 0 -8 C 52 -55 126 -42 151 10 C 181 73 125 136 48 152 C -54 174 -151 105 -172 17 C -201 -101 -104 -213 31 -238 C 183 -266 330 -185 391 -74"
      />
    </defs>

    <g transform="translate(560 342) rotate(-8)">
      <g transform="scale(1 .43)">
        <circle
          cx="0"
          cy="0"
          r="438"
          fill="url(#galaxy-halo)"
          filter="url(#galaxy-blur-xl)"
          opacity=".62"
        />

        <g fill="none" stroke-linecap="round" mask="url(#galaxy-arm-mask)">
          <g class="galaxy-light" stroke="url(#galaxy-arm)" stroke-width="96" opacity=".18" filter="url(#galaxy-blur-xl)">
            <use href="#galaxy-spiral-arm" />
            <use href="#galaxy-spiral-arm" transform="rotate(158) scale(.82)" />
          </g>

          <g class="galaxy-light" stroke="url(#galaxy-arm)" stroke-width="46" opacity=".28" filter="url(#galaxy-blur-md)">
            <use href="#galaxy-spiral-arm" />
            <use href="#galaxy-spiral-arm" transform="rotate(162) scale(.82)" />
          </g>

          <g class="galaxy-light" stroke="url(#galaxy-arm)" stroke-width="21" opacity=".2" filter="url(#galaxy-blur-md)">
            <use href="#galaxy-spiral-arm" transform="rotate(48) scale(.74)" />
            <use href="#galaxy-spiral-arm" transform="rotate(232) scale(.57)" />
          </g>

          <g stroke="url(#galaxy-dust)" stroke-width="8" opacity=".48" filter="url(#galaxy-blur-sm)">
            <use href="#galaxy-spiral-arm" transform="rotate(6)" />
            <use href="#galaxy-spiral-arm" transform="rotate(166) scale(.84)" />
          </g>

          <g class="galaxy-light" stroke="url(#galaxy-arm)" stroke-width="4" opacity=".34" filter="url(#galaxy-blur-sm)">
            <use href="#galaxy-spiral-arm" transform="rotate(-4)" />
            <use href="#galaxy-spiral-arm" transform="rotate(158) scale(.82)" />
          </g>

          <g
            class="galaxy-light galaxy-star-streams"
            stroke="#e8f6ff"
            stroke-width="1.6"
            stroke-dasharray=".8 23 1.4 47 .7 17 1.6 63"
            opacity=".44"
          >
            <use href="#galaxy-spiral-arm" />
            <use href="#galaxy-spiral-arm" transform="rotate(162) scale(.82)" />
          </g>
        </g>

        <ellipse
          cx="0"
          cy="0"
          rx="136"
          ry="104"
          fill="url(#galaxy-core)"
          filter="url(#galaxy-blur-md)"
          opacity=".76"
        />
        <ellipse cx="0" cy="0" rx="58" ry="43" fill="url(#galaxy-core)" opacity=".9" />

        <g class="galaxy-light galaxy-core-stars" fill="#fff8df">
          <circle cx="-18" cy="-8" r="2.4" />
          <circle cx="23" cy="11" r="1.9" />
          <circle cx="47" cy="-18" r="1.2" />
          <circle cx="-51" cy="19" r="1.3" />
          <circle cx="12" cy="-43" r="1.1" />
          <circle cx="-6" cy="38" r=".9" />
        </g>
      </g>

    </g>
  </svg>
</div>
